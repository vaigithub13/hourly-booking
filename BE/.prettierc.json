{
  "tabWidth": 2,
  "printWidth": 120,
  "proseWrap": "never",
  "trailingComma": "es5",
  "singleQuote": true,
  "semi": true,
  "editorconfig": true,
  "overrides": [
    {
      "files": ["*.json", "*.jsonc", "*.md", "*.yml"],
      "options": {
        "tabWidth": 2,
        "singleQuote": false
      }
    }
  ]
}
