  "private": true,
  "scripts": {
    "start": "node dist/index.js",
    "dev": "cross-env NODE_ENV=development nodemon",
    "stage": "cross-env NODE_ENV=stage nodemon",
    "build": "rm -rf dist && node esbuild.config.ts",
    "type:check": "tsc --watch",
    "lint": "tsc --noEmit && eslint --cache 'src/**/*.ts' --quiet",
    "format": "prettier --write 'src/**/*.ts' --quite && eslint 'src/**/*.ts' --fix --quiet",
    "test": "cross-env NODE_ENV=test tap src/**/*.spec.ts",
    "test:coverage": "yarn test --cov --coverage-report=html --coverage-report=cobertura | tee out.tap",
    "dev:up": "docker-compose -f docker-compose.dev.yml up -d",
    "dev:down": "docker-compose -f docker-compose.dev.yml down --remove-orphans"
  },
  "dependencies": {
